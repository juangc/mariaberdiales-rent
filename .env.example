DOMAIN=piso.example.com
ADMIN_EMAIL=propietario@example.com
ADMIN_NAME=Administrador
MYSQL_DATABASE=maria_berdiales
MYSQL_USER=maria_berdiales
# Solo para desarrollo local. En Docker se utiliza secrets/admin_password.txt.
ADMIN_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PASSWORD=
WIFI_RECOMMENDED_SSID=MOVISTAR_PLUS_3050
WIFI_SECONDARY_SSID=MOVISTAR_3050
# Solo para desarrollo local. En Docker se utiliza secrets/wifi_password.txt.
WIFI_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000
MAIL_FROM=tu-correo@tu-dominio.com
SENDMAIL_PATH=/usr/sbin/sendmail
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-correo@tu-dominio.com
SMTP_PASSWORD=la-contraseña-smtp
SMTP_SECURE=false
